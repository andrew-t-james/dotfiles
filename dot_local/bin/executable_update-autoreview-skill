#!/bin/zsh

set -euo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

readonly upstream_repo="https://github.com/openclaw/agent-skills.git"
readonly upstream_skill_path="skills/autoreview"
readonly skill_source_rel="dot_agents/skills/autoreview"
readonly lock_source_rel="dot_agents/dot_skill-lock.json"
readonly skill_target="${HOME}/.agents/skills/autoreview"
readonly lock_target="${HOME}/.agents/.skill-lock.json"
readonly codex_target="${HOME}/.codex/skills/autoreview"

log() {
  print -r -- "$(date -u +%Y-%m-%dT%H:%M:%SZ) $*"
}

for command_name in chezmoi git jq python3 rsync; do
  if ! command -v "${command_name}" >/dev/null 2>&1; then
    log "missing required command: ${command_name}"
    exit 1
  fi
done

source_root="$(chezmoi source-path)"
skill_source="${source_root}/${skill_source_rel}"
lock_source="${source_root}/${lock_source_rel}"

if [[ ! -f "${lock_source}" ]]; then
  log "missing skill lock file: ${lock_source}"
  exit 1
fi

runtime_root="${TMPDIR:-/tmp}"
monitor_lock="${runtime_root%/}/com.local.autoreview-skill-updater.lock"
if ! mkdir "${monitor_lock}" 2>/dev/null; then
  log "another updater is already running"
  exit 0
fi

checkout=""
cleanup() {
  [[ -z "${checkout}" ]] || rm -rf "${checkout}"
  rmdir "${monitor_lock}" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

checkout="$(mktemp -d "${runtime_root%/}/autoreview-skill.XXXXXX")"
git clone \
  --quiet \
  --filter=blob:none \
  --no-checkout \
  --depth 1 \
  --branch main \
  "${upstream_repo}" \
  "${checkout}"
git -C "${checkout}" sparse-checkout init --cone
git -C "${checkout}" sparse-checkout set "${upstream_skill_path}"
git -C "${checkout}" checkout --quiet

upstream_revision="$(git -C "${checkout}" rev-parse HEAD)"
upstream_tree="$(git -C "${checkout}" rev-parse "HEAD:${upstream_skill_path}")"
current_tree="$(jq -r '.skills.autoreview.skillFolderHash // empty' "${lock_source}")"

apply_targets() {
  chezmoi apply --force \
    "${skill_target}" \
    "${lock_target}" \
    "${codex_target}"
}

encode_for_chezmoi() {
  local source_dir="$1"

  mv \
    "${source_dir}/scripts/autoreview" \
    "${source_dir}/scripts/executable_autoreview"
  mv \
    "${source_dir}/scripts/test-review-harness" \
    "${source_dir}/scripts/executable_test-review-harness"

  if [[ -L "${source_dir}/CLAUDE.md" ]]; then
    local link_target
    link_target="$(readlink "${source_dir}/CLAUDE.md")"
    unlink "${source_dir}/CLAUDE.md"
    print -rn -- "${link_target}" >"${source_dir}/symlink_CLAUDE.md"
  fi
}

normalized_source_tree() {
  local encoded_source="$1"
  local normalized_source="${checkout}/current-autoreview"

  if [[ ! -d "${encoded_source}" ]]; then
    return 0
  fi

  mkdir -p "${normalized_source}"
  rsync -a "${encoded_source}/" "${normalized_source}/"
  mv \
    "${normalized_source}/scripts/executable_autoreview" \
    "${normalized_source}/scripts/autoreview"
  mv \
    "${normalized_source}/scripts/executable_test-review-harness" \
    "${normalized_source}/scripts/test-review-harness"

  if [[ -f "${normalized_source}/symlink_CLAUDE.md" ]]; then
    local link_target
    link_target="$(<"${normalized_source}/symlink_CLAUDE.md")"
    rm "${normalized_source}/symlink_CLAUDE.md"
    ln -s "${link_target}" "${normalized_source}/CLAUDE.md"
  fi

  git -C "${normalized_source}" init --quiet
  git -C "${normalized_source}" \
    -c core.excludesFile=/dev/null \
    -c core.autocrlf=false \
    add -A
  git -C "${normalized_source}" write-tree
}

if [[ -n "${current_tree}" ]]; then
  local_tree="$(normalized_source_tree "${skill_source}")"
  if [[ "${local_tree}" != "${current_tree}" ]]; then
    log "refusing to overwrite locally modified autoreview source"
    log "recorded tree: ${current_tree}"
    log "local tree: ${local_tree:-missing}"
    exit 1
  fi
fi

if [[ "${current_tree}" == "${upstream_tree}" ]]; then
  apply_targets
  log "autoreview is current at ${upstream_revision}"
  exit 0
fi

upstream_skill="${checkout}/${upstream_skill_path}"
for required_file in \
  "AGENTS.md" \
  "SKILL.md" \
  "scripts/autoreview" \
  "scripts/autoreview_test.py" \
  "tests/test_autoreview_hardening.py"; do
  if [[ ! -e "${upstream_skill}/${required_file}" ]]; then
    log "upstream skill is missing ${required_file}"
    exit 1
  fi
done

(
  cd "${upstream_skill}"
  unset RUSTUP_HOME CARGO_HOME
  ./scripts/autoreview --self-test
  python3 scripts/autoreview_test.py
  python3 -m unittest discover -s tests -p 'test_*.py'
)

mkdir -p "${skill_source}"
rsync -a --delete "${upstream_skill}/" "${skill_source}/"
encode_for_chezmoi "${skill_source}"

now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
installed_at="$(jq -r '.skills.autoreview.installedAt // empty' "${lock_source}")"
if [[ -z "${installed_at}" ]]; then
  installed_at="${now}"
fi

updated_lock="${checkout}/skill-lock.json"
jq \
  --arg installed_at "${installed_at}" \
  --arg updated_at "${now}" \
  --arg tree_hash "${upstream_tree}" \
  '.skills.autoreview = {
    "source": "openclaw/agent-skills",
    "sourceType": "github",
    "sourceUrl": "https://github.com/openclaw/agent-skills.git",
    "skillPath": "skills/autoreview/SKILL.md",
    "skillFolderHash": $tree_hash,
    "pluginName": "agent-skills",
    "installedAt": $installed_at,
    "updatedAt": $updated_at
  }' \
  "${lock_source}" >"${updated_lock}"
mv "${updated_lock}" "${lock_source}"

apply_targets
log "updated autoreview to ${upstream_revision} (tree ${upstream_tree})"
