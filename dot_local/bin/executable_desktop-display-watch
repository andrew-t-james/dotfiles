#!/usr/bin/env bash
# Recover enabled 0x0 outputs after returning to a graphical session.
set -uo pipefail
next_reload=0

recover_display() {
  local session=${XDG_SESSION_ID:-}
  (( SECONDS >= next_reload )) || return 0
  if [[ -z $session ]]; then
    session=$(loginctl show-user "$UID" -p Display --value 2>/dev/null) || return 0
  fi
  [[ -n $session ]] || return 0
  [[ $(loginctl show-session "$session" -p User --value 2>/dev/null) == "$UID" ]] || return 0
  [[ $(loginctl show-session "$session" -p Active --value 2>/dev/null) == yes ]] || return 0
  # Package transactions intentionally pause monitor reloads.
  omarchy-hyprland-reload-guard paused && return 0
  # Exit 0 means an enabled monitor has zero width/height; 1 is healthy,
  # and 2 means IPC failed. Never reload in response to an IPC failure.
  omarchy-hyprland-monitor-modeless || return 0
  # The user may have switched VTs while the monitor query was in flight.
  [[ $(loginctl show-session "$session" -p Active --value 2>/dev/null) == yes ]] || return 0
  # A persistent EDID/GPU failure must not cause a config-reload storm.
  next_reload=$((SECONDS + 30))
  printf 'desktop-display-watch: recovering a modeless output in session %s\n' "$session"
  hyprctl reload
}

main() {
  if [[ ${1:-} == --once ]]; then
    recover_display
    return $?
  fi
  while true; do
    recover_display || true
    sleep 3
  done
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
