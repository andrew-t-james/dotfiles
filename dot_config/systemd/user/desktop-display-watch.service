[Unit]
Description=Recover modeless displays when this desktop session is active
PartOf=graphical-session.target
After=graphical-session.target wayland-wm@hyprland.desktop.service

[Service]
ExecStart=%h/.local/bin/desktop-display-watch
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
